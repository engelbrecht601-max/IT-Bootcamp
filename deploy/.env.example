# Kopie als deploy/.env anlegen (./init-env.sh erzeugt die Passwörter). deploy/.env nie committen.

DOMAIN=aifactoryworkshop.de
# Kontakt für Let's Encrypt
ACME_EMAIL=

# Gemeinsames Workshop-Repo, wird in jedem Arbeitsplatz beim ersten Start geklont
REPO_URL=https://github.com/engelbrecht601-max/IT-Bootcamp.git
# Startstand, von dem die Gruppenbranches abzweigen
REPO_BRANCH=main
# Jede Gruppe arbeitet auf <Präfix><N>, z. B. workshop/gruppe3. Für einen neuen Durchlauf ein neues
# Präfix wählen (z. B. workshop-2026-12/gruppe), dann starten alle Gruppen frisch.
GROUP_BRANCH_PREFIX=workshop/gruppe
# Fine-grained Token nur mit Contents: write auf dieses eine Repo. Leer lassen = Gruppen können nicht pushen.
GIT_PUSH_TOKEN=

# ── Claude-Anmeldung: der Server meldet an, nie die Studierenden ─────────────────────────────
# Genau einen der beiden Wege füllen. Ist beides gesetzt, gewinnt der API-Key.
# Prüfen nach dem Start: ./check-auth.sh
#
# Weg 1, API: eigener Key nur für den Workshoptag, mit Spend Cap, danach widerrufen.
ANTHROPIC_API_KEY=
# Optional ein Key pro Gruppe (wegen Rate Limits), sonst gilt ANTHROPIC_API_KEY
ANTHROPIC_API_KEY_GRUPPE1=
ANTHROPIC_API_KEY_GRUPPE2=
ANTHROPIC_API_KEY_GRUPPE3=
ANTHROPIC_API_KEY_GRUPPE4=
ANTHROPIC_API_KEY_GRUPPE5=
#
# Weg 2, Abo (Max/Team): auf einem Rechner mit Browser `claude setup-token` ausführen, im Abo-Konto
# freigeben, das ausgegebene Token (gilt ein Jahr) hier eintragen. Siehe README, Abschnitt Anmeldung.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional ein Token pro Gruppe (z. B. ein Seat pro Gruppe), sonst gilt CLAUDE_CODE_OAUTH_TOKEN
CLAUDE_CODE_OAUTH_TOKEN_GRUPPE1=
CLAUDE_CODE_OAUTH_TOKEN_GRUPPE2=
CLAUDE_CODE_OAUTH_TOKEN_GRUPPE3=
CLAUDE_CODE_OAUTH_TOKEN_GRUPPE4=
CLAUDE_CODE_OAUTH_TOKEN_GRUPPE5=
#
# Optional für alle Sessions: Modell festlegen (z. B. sonnet). Leer = Standard von Claude Code.
ANTHROPIC_MODEL=

# Host-Ordner mit den Persona-Dateien aus dem privaten Lösungsrepo (wird schreibgeschützt eingebunden)
PERSONAS_DIR=/srv/aifactory/personas

# code-server-Passwörter, je Gruppe eins
GRUPPE1_PASSWORD=
GRUPPE2_PASSWORD=
GRUPPE3_PASSWORD=
GRUPPE4_PASSWORD=
GRUPPE5_PASSWORD=

# Host-Ports für Caddy, lokal unter Windows z. B. 8080/8443
HTTP_PORT=80
HTTPS_PORT=443

# Ressourcen je Arbeitsplatz (5 Personen, 5 Claude-Sessions, Tests und Dev-Server parallel)
WORKSPACE_CPUS=4
WORKSPACE_MEMORY=12g
