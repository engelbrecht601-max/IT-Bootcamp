# Kopie als deploy/.env anlegen (./init-env.sh erzeugt die Passwörter). deploy/.env nie committen.

DOMAIN=aifactoryworkshop.de
# Kontakt für Let's Encrypt
ACME_EMAIL=

# Gemeinsames Workshop-Repo, wird in jedem Arbeitsplatz beim ersten Start geklont
REPO_URL=https://github.com/engelbrecht601-max/IT-Bootcamp.git
REPO_BRANCH=main
# Fine-grained Token nur mit Contents: write auf dieses eine Repo. Leer lassen = Gruppen können nicht pushen.
GIT_PUSH_TOKEN=

# Eigener Key nur für den Workshoptag, mit Spend Cap, danach widerrufen.
ANTHROPIC_API_KEY=
# Optional ein Key pro Gruppe (wegen Rate Limits), sonst gilt ANTHROPIC_API_KEY
ANTHROPIC_API_KEY_GRUPPE1=
ANTHROPIC_API_KEY_GRUPPE2=
ANTHROPIC_API_KEY_GRUPPE3=
ANTHROPIC_API_KEY_GRUPPE4=
ANTHROPIC_API_KEY_GRUPPE5=

# Host-Ordner mit den Persona-Dateien aus dem privaten Lösungsrepo (wird schreibgeschützt eingebunden)
PERSONAS_DIR=/srv/aifactory/personas

# code-server-Passwörter, je Gruppe eins
GRUPPE1_PASSWORD=
GRUPPE2_PASSWORD=
GRUPPE3_PASSWORD=
GRUPPE4_PASSWORD=
GRUPPE5_PASSWORD=

# Ressourcen je Arbeitsplatz
WORKSPACE_CPUS=2.5
WORKSPACE_MEMORY=8g
