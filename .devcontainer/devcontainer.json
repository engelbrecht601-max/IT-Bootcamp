{
  "name": "IT-Bootcamp Track 1",
  "build": {
    "dockerfile": "../deploy/Dockerfile",
    "context": "..",
    "target": "base"
  },
  "remoteUser": "node",
  "containerEnv": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
    "PERSONAS_SRC": "${localEnv:PERSONAS_SRC}",
    "BOOTCAMP_GROUP": "${localEnv:BOOTCAMP_GROUP}"
  },
  "postCreateCommand": "pnpm install --frozen-lockfile --prefer-offline && pnpm run doctor",
  "forwardPorts": [
    4000,
    5173
  ],
  "portsAttributes": {
    "4000": {
      "label": "Mock-Server"
    },
    "5173": {
      "label": "UI"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "redhat.vscode-yaml"
      ]
    }
  },
  "postStartCommand": "if [ -n \"$PERSONAS_SRC\" ]; then pnpm personas:install; fi; if [ -n \"$BOOTCAMP_GROUP\" ]; then pnpm group:setup \"$BOOTCAMP_GROUP\" --force; fi"
}
